# ──────────────────────────────────────────────────────────
# Wedding RSVP System - Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to ../.env (project root) and fill in values.
# The .env file is loaded by EnvironmentLoader.php.
# ──────────────────────────────────────────────────────────

# ─── Database Configuration ──────────────────────────────
# Default engine is MySQL (set DB_ENGINE=pgsql for PostgreSQL).

DB_ENGINE=mysql

# MySQL / MariaDB credentials (GoDaddy / shared hosting)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wedding_rsvp
DB_USER=root
DB_PASS=

# PostgreSQL credentials (legacy, for local dev only)
PG_HOST=localhost
PG_PORT=5432
PG_DB=wedding_rsvp
PG_USER=postgres
PG_PASS=

# ─── Site URL ─────────────────────────────────────────────
# Public URL where guests will access the website.
# Used for QR codes and invitation links. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# ─── Security ─────────────────────────────────────────────
# Session settings
SESSION_TIMEOUT=3600
SESSION_SECURE_COOKIE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,https://yourdomain.com

# Environment (development or production)
ENVIRONMENT=development

# ─── Encryption (optional) ────────────────────────────────
# Generate with: php rsvp/setup-encryption.php
# ENCRYPTION_KEY=

# ─── Google Sheets Export (optional) ──────────────────────
# GOOGLE_SHEETS_ID=your_sheets_id
# GOOGLE_SHEETS_CREDENTIALS_PATH=/path/to/credentials.json

# ─── Dev Bypass (local testing only, disabled by default) ─
# ENABLE_DEV_GUEST_BYPASS=false
# DEV_GUEST_INVITATION_ID=dev
# DEV_GUEST_PASSWORD=dev
# DEV_GUEST_NAME=Local Dev Guest
# DEV_GUEST_MAX_GUESTS=2
# ENABLE_DEV_ADMIN_BYPASS=false
# DEV_ADMIN_USERNAME=dev
# DEV_ADMIN_PASSWORD=dev


# --- Email Delivery (invitations) ------------------------
# From address used for invitation emails. Required to use the 'Send' button.
# MAIL_FROM=noreply@yourdomain.com
# MAIL_FROM_NAME=Jason & Rhona Mae
#
# Set to true to use SMTP instead of PHP mail() (Gmail, SendGrid, etc.)
# MAIL_USE_SMTP=false
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
