# Block direct web access to guest-uploaded files.
# Photos are served only through /rsvp/api.php?action=serve-reception-photo (requires key).
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Never execute scripts from the upload directory.
<FilesMatch "\.(php|php\d|phtml|phar|cgi|pl|py|asp|aspx|jsp|sh|exe|bat|cmd)$">
    Require all denied
</FilesMatch>
