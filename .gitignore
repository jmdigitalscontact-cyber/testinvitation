# Blackbox
.blackbox/

# Environment / secrets (never commit)
.env
.env.*
!.env.example

# Logs
logs/
server_log.txt
server_err.txt

# Generated QR codes (regenerated on demand)
rsvp/qr_codes/*
!rsvp/qr_codes/.gitkeep

# Guest photo uploads
reception/uploads/*
!reception/uploads/.gitkeep
!reception/uploads/.htaccess

# Google service-account / credential JSON
**/credentials/*.json
**/JSON/*.json
**/google-sheets*.json
**/wedding-rsvp-*.json

# Local tooling / virtualenv
.venv/
__pycache__/
*.pyc

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

